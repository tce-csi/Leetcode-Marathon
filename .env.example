# ---------------------------------------------------------------------------
# CodeQuest — environment variables (monorepo overview)
# ---------------------------------------------------------------------------
# This repository is an npm workspaces monorepo with two apps:
#
#   server/   Express + TypeScript API        -> reads server/.env
#   client/   React + Vite single-page app     -> reads client/.env
#
# Each workspace ships its own annotated `.env.example`. Copy them to the
# matching `.env` file before running:
#
#   Copy-Item server\.env.example server\.env
#   Copy-Item client\.env.example client\.env
#
# NEVER commit real `.env` files or secrets.
#
# The most important values are summarised below.
# ---------------------------------------------------------------------------

# ---------------------------------------------------------------------------
# server/.env
# ---------------------------------------------------------------------------
# PORT=5050
# NODE_ENV=development
# FRONTEND_URL=http://localhost:5173
#
# Database (Supabase PostgreSQL or any PostgreSQL 15+). Use the pooler URL
# (port 6543) with ?sslmode=require for hosted Postgres.
# DATABASE_URL="postgresql://postgres.<project-ref>:<password>@<region>.pooler.supabase.com:6543/postgres?sslmode=require"
#
# 32+ byte random secret. Generate with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
# JWT_SECRET="change-me-to-a-long-random-string-at-least-32-chars"
#
# Optional screenshot-evidence storage (Supabase Storage). Uploads degrade
# gracefully when unset.
# SUPABASE_URL=""
# SUPABASE_SERVICE_ROLE_KEY=""
# SUPABASE_STORAGE_BUCKET="codequest-evidence"
#
# Bootstrap administrator (used only by `npm run db:seed`).
# SEED_ADMIN_EMAIL="admin@codequest.local"
# SEED_ADMIN_PASSWORD="ChangeMe_12345"
# SEED_ADMIN_NAME="Contest Administrator"
#
# Verification + rate limiting.
# VERIFICATION_PROVIDERS="manual"
# ENABLE_LEETCODE_GRAPHQL_PROVIDER="false"
# RATE_LIMIT_WINDOW_SECONDS="60"
# RATE_LIMIT_MAX_REQUESTS="30"

# ---------------------------------------------------------------------------
# client/.env
# ---------------------------------------------------------------------------
# Leave empty in development to use the Vite dev-server proxy.
# In production, set this to the absolute URL of the deployed API.
# VITE_API_ORIGIN=
#
# Only used by the Vite dev-server proxy to reach the local API.
# VITE_API_PROXY=http://localhost:5050

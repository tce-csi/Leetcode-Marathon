# ---------------------------------------------------------------------------
# CodeQuest API - environment variables
# Copy this file to `.env` and fill in real values. NEVER commit secrets.
# ---------------------------------------------------------------------------

# ---------------------------------------------------------------------------
# Server
# ---------------------------------------------------------------------------
PORT=5050
NODE_ENV=development

# Public base URL of the deployed frontend (no trailing slash).
# Used for CORS and for validating same-origin/CSRF checks.
FRONTEND_URL=http://localhost:5173

# Comma-separated list of additional allowed browser origins (optional).
# CORS_ORIGINS=http://localhost:5173,https://your-frontend.vercel.app

# ---------------------------------------------------------------------------
# Database (Supabase PostgreSQL or any PostgreSQL 15+)
# ---------------------------------------------------------------------------
# In Supabase: Project Settings -> Database -> Connection string -> "Nodejs" (pooler) or "URI".
# Use the pooler (port 6543) for serverless; append ?sslmode=require
DATABASE_URL="postgresql://postgres.<project-ref>:<password>@<region>.pooler.supabase.com:6543/postgres?sslmode=require"

# ---------------------------------------------------------------------------
# Application secret
# ---------------------------------------------------------------------------
# 32+ byte random string used to derive session/CSRF signing material.
# Generate with: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_SECRET="change-me-to-a-long-random-string-at-least-32-chars"

# ---------------------------------------------------------------------------
# Supabase (optional - used for storage of screenshot evidence)
# ---------------------------------------------------------------------------
# Project URL and keys from Supabase -> Project Settings -> API.
# The service role key is ONLY used server-side and must never be exposed to the client.
SUPABASE_URL=""
SUPABASE_SERVICE_ROLE_KEY=""
# Storage bucket used for submission screenshots (create it in Supabase Storage).
SUPABASE_STORAGE_BUCKET="codequest-evidence"

# ---------------------------------------------------------------------------
# Bootstrap administrator (used only by `npm run db:seed`)
# ---------------------------------------------------------------------------
SEED_ADMIN_EMAIL="admin@codequest.local"
SEED_ADMIN_PASSWORD="ChangeMe_12345"
SEED_ADMIN_NAME="Contest Administrator"

# ---------------------------------------------------------------------------
# Verification architecture
# ---------------------------------------------------------------------------
# Comma separated ordered list of verification providers to attempt.
# Supported values: "manual" (always available), "leetcode-graphql" (best effort,
# only used when explicitly enabled and understood to be an unofficial endpoint).
VERIFICATION_PROVIDERS="manual"
# Only enable the unofficial LeetCode GraphQL provider when you have reviewed and
# accepted its terms. "true" | "false"
ENABLE_LEETCODE_GRAPHQL_PROVIDER="false"

# ---------------------------------------------------------------------------
# Rate limiting
# ---------------------------------------------------------------------------
RATE_LIMIT_WINDOW_SECONDS="60"
RATE_LIMIT_MAX_REQUESTS="30"
